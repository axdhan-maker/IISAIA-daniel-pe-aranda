# Copiar a .streamlit/secrets.toml (no se commitea) y completar.
#
# En Auth0 (https://manage.auth0.com), Applications > Create Application >
# "Regular Web Applications". En Settings:
#   Allowed Callback URLs: http://localhost:8501/oauth2callback
#   Allowed Logout URLs:   http://localhost:8501
# Domain, Client ID y Client Secret salen de esa misma pantalla.

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
# secreto largo y aleatorio para firmar la cookie de sesion:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
cookie_secret = "CAMBIAR"
client_id = "CAMBIAR"
client_secret = "CAMBIAR"
server_metadata_url = "https://<tu-dominio>.auth0.com/.well-known/openid-configuration"
# opcional: pedir siempre la pantalla de Auth0, aunque ya haya sesion abierta
# alli (st.logout solo cierra la sesion de la app, no la de Auth0)
# client_kwargs = { prompt = "login" }
